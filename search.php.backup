<?php
include "config.php";
include "aliexpress_api.php";

$query = $_GET['q'] ?? '';

if ($query == '') {
    die("<h3>Please enter a search keyword.</h3>");
}

// ✅ CORRECT: endpoint + params separated
$response = aliAPI("search", [
    "query" => $query,
    "page"  => 1
]);

// Debug helper (TEMPORARY)
// echo "<pre>"; print_r($response); exit;

$products = $response['data']['products'] ?? [];

?>
<!DOCTYPE html>
<html>
<head>
    <title>Search Results</title>
    <style>
        body { font-family: Arial; padding: 20px; }
        .product { border: 1px solid #ddd; padding: 15px; width: 220px; margin: 10px; float: left; }
        img { width: 200px; height: 200px; object-fit: cover; }
    </style>
</head>
<body>

<h2>Search results for: <b><?php echo htmlspecialchars($query); ?></b></h2>

<?php if (empty($products)): ?>
    <p>No products found.</p>
<?php endif; ?>

<?php foreach ($products as $p): ?>
    <div class="product">
        <img src="<?php echo $p['image'] ?? ''; ?>">
        <h4><?php echo $p['title'] ?? ''; ?></h4>
        <p><b>Price:</b> <?php echo $p['price'] ?? ''; ?></p>
        <a href="product.php?id=<?php echo $p['product_id'] ?? ''; ?>">
            <button>View Details</button>
        </a>
    </div>
<?php endforeach; ?>

</body>
</html>
